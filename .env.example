# ============================================================================
# Local Orchestration Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Then source it before running scripts:
#   set -a; source .env; set +a
#
# Or use the setup helper:
#   bash scripts/setup-local-env.sh
# ============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — Orchestration will not start without these
# ---------------------------------------------------------------------------

# GitHub Personal Access Token (org-level PAT)
# Required scopes: repo, workflow, project, read:org
# Used by: gh CLI, opencode MCP GitHub server, orchestrator agent
GH_ORCHESTRATION_AGENT_TOKEN=

# ZhipuAI API key — access to GLM models (primary model provider)
ZHIPU_API_KEY=

# Kimi / Moonshot API key — backup model provider
KIMI_CODE_ORCHESTRATOR_AGENT_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — Additional model providers
# ---------------------------------------------------------------------------

# OpenAI API key (GPT models)
# OPENAI_API_KEY=

# Google Gemini API key (mapped to GOOGLE_GENERATIVE_AI_API_KEY in container)
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — Server configuration (defaults shown)
# ---------------------------------------------------------------------------

# Bind address for opencode serve (0.0.0.0 = all interfaces)
# OPENCODE_SERVER_HOSTNAME=0.0.0.0

# Listen port for opencode serve
# OPENCODE_SERVER_PORT=4096

# ---------------------------------------------------------------------------
# OPTIONAL — Server authentication (for LAN access)
# ---------------------------------------------------------------------------

# Basic auth credentials — when set, clients must include these in attach URLs
# OPENCODE_SERVER_USERNAME=
# OPENCODE_SERVER_PASSWORD=

# ============================================================================
# GapMiner Application
# ============================================================================
# Secrets for the GapMiner intelligence platform. NEVER hardcode these in code
# or appsettings.json. They are read from the environment / Aspire parameters.

# ---------------------------------------------------------------------------
# REQUIRED — scraping + AI analysis will not function without these
# ---------------------------------------------------------------------------

# Apify API bearer token (review scraping across marketplaces)
APIFY_TOKEN=

# LLM provider selection: "azureopenai" or "anthropic"
AI_PROVIDER=azureopenai

# Azure OpenAI (when AI_PROVIDER=azureopenai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Anthropic Claude (when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — infrastructure (compose / standalone deployments)
# ---------------------------------------------------------------------------

# PostgreSQL password (used by docker-compose.yml; default: gapminer_dev)
POSTGRES_PASSWORD=gapminer_dev

# Connection string overrides (Aspire sets these automatically in dev)
# ConnectionStrings__gapminer=Host=localhost;Port=5432;Database=gapminer;Username=gapminer;Password=gapminer_dev
# ConnectionStrings__redis=localhost:6379
